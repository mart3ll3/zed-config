// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "colorize_brackets": true,
  "auto_update": false,
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "model": [
          "lmstudio/google/gemma-4-26b-a4b"
        ]
      },
      "type": "registry"
    },
    "omp": {
      "default_config_options": {
        "thinking": "high",
        "model": "openai-codex/gpt-5.6-sol"
      },
      "type": "custom",
      "command": "omp",
      "args": ["acp"],
      "env": {}
    }
  },
  "icon_theme": "VSCode Icons for Zed (Dark Official Icons)",
  "agent": {
    "dock": "left",
    "default_model": {
      "enable_thinking": true,
      "provider": "google",
      "model": "gemini-2.5-flash"
    },
    "model_parameters": []
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "low_speed_timeout_in_seconds": 120,
      "available_models": [
        {
          "name": "qwen2.5",
          "display_name": "qwen 2.5 coder 8K",
          "max_tokens": 8192
        }
      ]
    }
  },
  "theme": "Dracula Solid",
  "base_keymap": "JetBrains",
  "scroll_beyond_last_line": "off",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "buffer_line_height": {
    "custom": 1.4
  },
  "ui_font_size": 17,
  "buffer_font_size": 16,
  "buffer_font_family": "MonoLisa Nerd Font Mono",
  "format_on_save": "off",
  "soft_wrap" : "editor_width",
  "remove_trailing_whitespace_on_save": false,
  "formatter": null,
  // "formatter": "prettier",
  "project_panel": {
    // "indent_size": 11,
    "dock": "right",
    "auto_fold_dirs": false
  },
  "vim": {
    "use_system_clipboard": "never"
  },
  "terminal":
  {
    "default_height": 9999
  },
    "command_aliases": {
      "th": "theme_selector::Toggle",
      "gs": "git_panel::Toggle",
      "km": "zed::OpenKeymap",
    }//,
